# ---------------------------------------------------------------------------
# C.O.R.E. configuration
# Copy to .env for local development. Never commit a real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Database ------------------------------------------------------------------
# Local development uses the docker-compose service on port 5433.
DATABASE_URL=postgresql://core:core_local_dev@localhost:5433/core
# Production verifies the database TLS certificate. Append ?sslmode=disable only
# when the database is reached over a private network you control; it is logged
# loudly at startup.

# Production only. Supply the managed provider's CA so the server certificate
# can be verified properly.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Last resort if the provider offers no downloadable CA. Encrypts but does not
# authenticate the connection, so it can be intercepted. Logged loudly.
# DATABASE_SSL_INSECURE_SKIP_VERIFY=false

# Web app -------------------------------------------------------------------
# Optional. Production serves the web app and the API from one origin and works
# out its own address from the request, so this normally stays unset. Set it
# only when a proxy rewrites the host the browser actually used.
# APP_URL=https://core.example.com

# Sessions ------------------------------------------------------------------
# Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# SESSION_SECRET=
SESSION_COOKIE_NAME=core_session
SESSION_TTL_HOURS=336

# Google sign-in (optional) -------------------------------------------------
# Without these the Google button is hidden and the endpoint says it is
# unconfigured rather than failing mysteriously.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Email (optional) ----------------------------------------------------------
# Without SMTP_URL, verification codes are written to the server log instead of
# being sent. Fine for local development, not for production.
# SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM="C.O.R.E. <no-reply@core.local>"

# Demo mode -----------------------------------------------------------------
DEMO_MODE_ENABLED=true
