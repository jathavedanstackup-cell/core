{
  "name": "@core/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic resilience domain engine: dependency propagation, single-point-of-failure detection, explainable risk, readiness, and solution generation. No I/O, no network, no AI.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.spec.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "vitest": "^3.0.5",
    "typescript": "^5.7.3",
    "@types/node": "^22.10.5"
  }
}
