{
  "name": "@core/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "seed:demo": "tsx src/db/seed-demo.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@core/engine": "*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.0.4",
    "drizzle-orm": "^0.38.4",
    "fastify": "^5.2.1",
    "nodemailer": "^6.10.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1",
    "pdfkit": "^0.15.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "@types/pdfkit": "^0.13.9"
  },
  "exports": {
    ".": "./dist/index.js",
    "./app": "./dist/app.js",
    "./config": "./dist/config.js",
    "./db/client": "./dist/db/client.js",
    "./db/schema": "./dist/db/schema.js",
    "./db/migrate": "./dist/db/migrate.js",
    "./services/*": "./dist/services/*.js"
  }
}
